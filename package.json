{
  "name": "zeroquota",
  "displayName": "ZeroQuota",
  "icon": "assets/icons/store-logo.png",
  "description": "A premium, high-performance AI quota monitoring and automation suite for the Antigravity IDE, featuring real-time telemetry and advanced model management.",
  "version": "1.0.3",
  "publisher": "ZeroQuota",
  "author": "kalidahmdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalidahmdev/ZeroQuota"
  },
  "bugs": {
    "url": "https://github.com/kalidahmdev/ZeroQuota/issues"
  },
  "homepage": "https://github.com/kalidahmdev/ZeroQuota#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zeroquota.refresh",
        "title": "ZeroQuota: Refresh Quota",
        "category": "ZeroQuota"
      },
      {
        "command": "zeroquota.openBrain",
        "title": "ZeroQuota: Open Brain Folder",
        "category": "ZeroQuota"
      },
      {
        "command": "zeroquota.openMcpConfig",
        "title": "ZeroQuota: Open MCP Config",
        "category": "ZeroQuota"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zeroquota-sidebar",
          "title": "Overview",
          "icon": "assets/icons/ZeroQuota.svg"
        }
      ]
    },
    "views": {
      "zeroquota-sidebar": [
        {
          "type": "webview",
          "id": "zeroquota.dashboard",
          "name": "Overview",
          "icon": "assets/icons/ZeroQuota.svg"
        }
      ]
    },
    "configuration": {
      "title": "ZeroQuota",
      "properties": {
        "zeroquota.autoUpdateInterval": {
          "type": "integer",
          "default": 60,
          "description": "Polling interval in seconds for quota updates."
        },
        "zeroquota.notificationThreshold": {
          "type": "integer",
          "default": 25,
          "description": "Percentage threshold to show quota warning notifications."
        },
        "zeroquota.modelPicker": {
          "type": "object",
          "default": {
            "geminiPro": true,
            "geminiFlash": true,
            "claude": true,
            "gptOss": true
          },
          "description": "Toggle visibility of specific model variants in the dashboard."
        },
        "zeroquota.refreshRate": {
          "type": "string",
          "enum": [
            "Real-time",
            "1m",
            "5m",
            "Manual"
          ],
          "default": "1m",
          "description": "Polling frequency for quota updates."
        },
        "zeroquota.autoSyncBrain": {
          "type": "boolean",
          "default": true,
          "description": "Periodically scan the Brain Directory for changes."
        },
        "zeroquota.notifyOnReset": {
          "type": "boolean",
          "default": false,
          "description": "Show a desktop notification when AI quotas are fully reset."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "node esbuild.js --production",
    "release": "npx ts-node src/scripts/release.ts",
    "test": "vitest run",
    "test:full": "npm run pretest && vitest run"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.7.1",
    "axios-mock-adapter": "^2.1.0",
    "c8": "^9.1.0",
    "chai": "^4.5.0",
    "esbuild": "^0.27.3",
    "eslint": "^8.57.0",
    "fantasticon": "^4.1.0",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "axios": "^1.7.2"
  }
}
